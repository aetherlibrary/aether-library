# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — API keys never leave your machine.

# Where your Markdown vault lives. An absolute path is recommended
# (e.g. C:\Users\you\Documents\vault or /Users/you/Documents/vault); a
# relative path is resolved against the folder the server is started from.
# Leave blank to connect a Vault from inside the app instead.
VAULT_PATH=./vault

# Active Vault Adapter for saving Sessions. Only "local" exists today.
VAULT_ADAPTER=local

# Local server port
PORT=8477

# Provider API keys (leave blank to disable a provider)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
PERPLEXITY_API_KEY=
DEEPSEEK_API_KEY=

# Provider default models (defaults shown; use Settings → Refresh models for live lists)
OPENAI_MODEL=gpt-5.1
ANTHROPIC_MODEL=claude-sonnet-4-5
GOOGLE_MODEL=gemini-2.5-pro
PERPLEXITY_MODEL=sonar-pro
DEEPSEEK_MODEL=deepseek-chat

# Provider enable state (Settings → API Providers). Blank/absent migrates to
# enabled when the provider has a key or is assigned to a Scholar/the Judge.
# A provider assigned to a character is always treated as enabled.
OPENAI_ENABLED=true
ANTHROPIC_ENABLED=true
GOOGLE_ENABLED=true
PERPLEXITY_ENABLED=false
DEEPSEEK_ENABLED=false

# Scholar slot assignment: which provider answers as each fixed character.
# Any provider may be assigned to any slot; the character identity never changes.
# SCHOLARn_MODEL is optional — blank uses that provider's default model above.
# SCHOLARn_ENABLED (default true) sets whether the Scholar participates by default.
SCHOLAR1_PROVIDER=openai
SCHOLAR2_PROVIDER=anthropic
SCHOLAR3_PROVIDER=google
SCHOLAR1_MODEL=
SCHOLAR2_MODEL=
SCHOLAR3_MODEL=

# Which provider synthesizes as the Judge / Grand Sage, and (optionally) its
# model. Blank JUDGE_MODEL uses the judge provider's default model above.
JUDGE_PROVIDER=anthropic
JUDGE_MODEL=

# Default Reply Language: the language every AI response defaults to —
# Scholars, the Grand Sage, Mentor and follow-ups alike: en | zh-TW
# Naming a language in your own prompt ("answer in English") overrides it for
# that request only. This does NOT change interface text.
# "en" is also what a fresh install uses when this is left unset.
DEFAULT_REPLY_LANGUAGE=en

# Librarian: max estimated tokens of vault context retrieved per question
LIBRARIAN_TOKEN_BUDGET=2000
